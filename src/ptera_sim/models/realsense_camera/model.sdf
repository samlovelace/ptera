<?xml version="1.0" ?>
<sdf version="1.7">
  <model name="realsense_camera">
    <pose>0 0 0 0 0 0</pose>

    <link name="camera_link">
      <pose>0 0 0 0 0 0</pose>
      <visual name="camera_visual">
        <pose>0 0 0.1 0 0 1.57</pose>
        <geometry>
          	<mesh>
             <uri>model://realsense_camera/meshes/RealSense_D435.dae</uri>
            </mesh>
          </geometry>
      </visual>

      <collision name="camera_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
            <mesh>
             <uri>model://realsense_camera/meshes/RealSense_D435.dae</uri>
            </mesh>
        </geometry>
      </collision>

      <!-- Left camera sensor -->
      <sensor name="left_camera" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.5</near>
            <far>3.5</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
      </sensor>

      <!-- Right camera sensor -->
      <sensor name="right_camera" type="camera">
        <pose>0 0.12 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.5</near>
            <far>3.5</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
      </sensor>

      <!-- Inertial properties -->
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>1e-5</ixx>
          <iyy>1e-5</iyy>
          <izz>1e-5</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

    </link>
  </model>
</sdf>
