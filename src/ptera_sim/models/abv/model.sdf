<?xml version="1.0"?>
<sdf version="1.8">
  <model name="abv">
    <static>false</static>
    <self_collide>true</self_collide>
  
    <!-- Mobile base -->
    <include>
      <uri>model://abv_chassis</uri>
      <name>base</name>
      <pose>0 0 0.04 0 0 0</pose>
    </include>

    <include>
      <uri>model://realsense_camera</uri>
      <name>camera</name>
      <pose>0.19 0.075 0.265 0 0 0</pose>
    </include>

    <include>
      <uri>model://widow_xl</uri>
      <name>wxr</name>
      <pose>0.155 -0.205 0.3 0 -1.57 1.57</pose>
      <plugin filename="libjoint_position_controller.so" name="JointPositionController">
        <publish>gazebo/joint_positions</publish>
        <command>gazebo/joint_commands</command>
        <initial_position>0 0 0 0</initial_position>
      </plugin>
    </include>

    <joint name="camera_mount" type="fixed">
      <parent>base::vehicle_frame</parent>
      <child>camera::camera_link</child>
    </joint>

    <!-- Fixed joint (weld) between the base link and the arm’s base link -->
    <joint name="weld_arm_to_base" type="fixed">
      <parent>base::vehicle_frame</parent>
      <child>wxr::widow_xl_base</child>
    </joint>

  </model>
</sdf>
